// Prisma Schema for Portfolio with Supabase PostgreSQL
// This schema defines all your database models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Volunteering Model
model Volunteering {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company      String
  position     String
  duration     String
  location     String
  description  String[]
  technologies String[]
  link         String?
  logoLight    String?  @map("logo_light")
  logoDark     String?  @map("logo_dark")
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("volunteering")
}

// Experience Model
model Experience {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company      String
  position     String
  duration     String
  location     String
  description  String[]
  technologies String[]
  link         String?
  logoLight    String?  @map("logo_light")
  logoDark     String?  @map("logo_dark")
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  current      Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("experiences")
}

// Project Model
model Project {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug         String   @unique
  title        String
  description  String
  thumbnail    String?
  technologies String[]
  github       String?
  live         String?
  date         DateTime @db.Date
  body         String?
  category     String   // 'personal' or 'university'
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("projects")
}

// Education Model
model Education {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  institution String
  degree      String
  field       String
  duration    String
  location    String
  description String[]
  logoLight   String?  @map("logo_light")
  logoDark    String?  @map("logo_dark")
  gpa         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("education")
}

// Certificate Model
model Certificate {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String
  issuer        String
  date          DateTime @db.Date
  credentialId  String?  @map("credential_id")
  credentialUrl String?  @map("credential_url")
  logo          String?
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("certificates")
}
