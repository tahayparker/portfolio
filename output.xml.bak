<page url="https://developers.cloudflare.com/analytics/graphql-api/tutorials/end-customer-analytics/">
<title>Querying HTTP events by hostname with GraphQL · Cloudflare Analytics docs</title>
<content><code language="code">          "httpRequestsAdaptiveGroups": [                "datetimeHour": "2022-07-21T10:00:00Z"                "edgeResponseBytes": 19849385,                "datetimeHour": "2022-07-21T06:00:00Z"                "edgeResponseBytes": 20607204,                "datetimeHour": "2022-07-26T05:00:00Z"                "edgeResponseBytes": 20170839,                "datetimeHour": "2022-07-23T08:00:00Z"                "edgeResponseBytes": 20141860,                "datetimeHour": "2022-07-25T15:00:00Z"                "edgeResponseBytes": 21070367,                "datetimeHour": "2022-07-28T08:00:00Z"                "edgeResponseBytes": 19200774,                "datetimeHour": "2022-07-26T02:00:00Z"                "edgeResponseBytes": 20758067,                "datetimeHour": "2022-07-20T19:00:00Z"                "edgeResponseBytes": 22127811,                "datetimeHour": "2022-07-27T15:00:00Z"                "edgeResponseBytes": 20480644,                "datetimeHour": "2022-07-27T17:00:00Z"                "edgeResponseBytes": 19885704,</code><paragraph>"httpRequestsAdaptiveGroups": [</paragraph><paragraph>"datetimeHour": "2022-07-21T10:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 19849385,</paragraph><paragraph>"datetimeHour": "2022-07-21T06:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 20607204,</paragraph><paragraph>"datetimeHour": "2022-07-26T05:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 20170839,</paragraph><paragraph>"datetimeHour": "2022-07-23T08:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 20141860,</paragraph><paragraph>"datetimeHour": "2022-07-25T15:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 21070367,</paragraph><paragraph>"datetimeHour": "2022-07-28T08:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 19200774,</paragraph><paragraph>"datetimeHour": "2022-07-26T02:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 20758067,</paragraph><paragraph>"datetimeHour": "2022-07-20T19:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 22127811,</paragraph><paragraph>"datetimeHour": "2022-07-27T15:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 20480644,</paragraph><paragraph>"datetimeHour": "2022-07-27T17:00:00Z"</paragraph><paragraph>"edgeResponseBytes": 19885704,</paragraph></content>
